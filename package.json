{
  "name": "@orizz-rs/ui",
  "version": "0.1.1",
  "description": "Reusable React components for Orizz products.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orizz-rs/orizz-ui.git"
  },
  "homepage": "https://github.com/orizz-rs/orizz-ui#readme",
  "bugs": {
    "url": "https://github.com/orizz-rs/orizz-ui/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/orizz-ui.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pack:check": "bun pm pack --dry-run",
    "publish:public": "bash scripts/publish-public.sh",
    "prepack": "bun run build",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run test"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/bai-jamjuree": "^5.3.0",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "lucide-react": "^1.31.0"
  }
}
